<mxfile host="app.diagrams.net">
  <diagram name="ERDiagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="users" value="USERS&#10;----------------&#10;PK: user_id&#10;full_name&#10;email&#10;password_hash&#10;phone&#10;role&#10;created_at&#10;updated_at"
          style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="180" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="client" value="CLIENT_PROFILE&#10;----------------&#10;PK: client_id&#10;FK: user_id&#10;company_name&#10;company_type&#10;website&#10;location"
          style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="240" width="190" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="freelancer" value="FREELANCER_PROFILE&#10;----------------&#10;PK: freelancer_id&#10;FK: user_id&#10;headline&#10;bio&#10;experience&#10;hourly_rate&#10;trust_score"
          style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="230" width="210" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="jobs" value="JOBS&#10;----------------&#10;PK: job_id&#10;FK: client_id&#10;title&#10;description&#10;budget&#10;deadline&#10;status"
          style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="470" width="190" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="proposals" value="PROPOSALS&#10;----------------&#10;PK: proposal_id&#10;FK: job_id&#10;FK: freelancer_id&#10;proposed_budget&#10;proposal_text&#10;status"
          style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="470" width="210" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="projects" value="PROJECTS&#10;----------------&#10;PK: project_id&#10;FK: proposal_id&#10;start_date&#10;end_date&#10;status"
          style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="700" width="210" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="payments" value="PAYMENTS&#10;PK: payment_id&#10;FK: project_id&#10;amount&#10;status"
          style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="920" width="180" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="milestones" value="MILESTONES&#10;PK: milestone_id&#10;FK: project_id&#10;title&#10;status"
          style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="920" width="180" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="reviews" value="REVIEWS&#10;PK: review_id&#10;FK: project_id&#10;rating&#10;comment"
          style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="920" width="180" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="users" target="client"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="users" target="freelancer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="client" target="jobs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="jobs" target="proposals"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="freelancer" target="proposals"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="proposals" target="projects"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="projects" target="payments"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" edge="1" parent="1" source="projects" target="milestones"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" edge="1" parent="1" source="projects" target="reviews"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
